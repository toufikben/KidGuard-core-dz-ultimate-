<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>
<!-- LAB ONLY. Not a deployment config. Placeholder values (dollar-brace VAR) are injected locally. -->
<properties>

    <entry key='database.driver'>org.h2.Driver</entry>
    <entry key='database.url'>jdbc:h2:./lab-data/database</entry>
    <entry key='database.user'>sa</entry>
    <entry key='database.password' />

    <entry key='web.address'>127.0.0.1</entry>
    <entry key='web.port'>8082</entry>

    <entry key='protocols.enable'>gt06,owntracks,osmand</entry>
    <entry key='database.registerUnknown'>false</entry>

    <entry key='event.forward.url'>http://${LAB_SINK_HOST}:${LAB_FORWARD_PORT}/alert</entry>
    <entry key='event.forward.header'>X-Lab-Sign: ${LAB_FORWARD_TOKEN}</entry>

    <!-- Measured (evidence 005 §4): a notification naming a channel outside this list throws in
         NotificationManager.updateEvents and the event delivers to NOBODY. Telegram is deliberately
         absent so the lab can never open a socket to api.telegram.org with a lab token. -->
    <entry key='notificator.types'>web,mail</entry>
    <entry key='notificator.telegram.key'>${LAB_TELEGRAM_BOT_TOKEN}</entry>
    <entry key='notificator.telegram.chatId'>${LAB_TELEGRAM_CHAT_ID}</entry>
    <entry key='notificator.telegram.sendLocation'>true</entry>

    <entry key='mail.smtp.host'></entry>
    <!-- true => Traccar swaps SmtpMailManager for LogMailManager: one INFO line per recipient and
         no SMTP socket, so fan-out is observable with no real mail account (evidence 005 §2).
         FLIP THIS TO false BEFORE ANY REAL-DELIVERY TEST (Task 8 Part B): while it is true the
         server logs "Email sent / To:" for every recipient it selected and delivers nothing, so
         that line alone can never prove a message arrived — it is a ready-made false PASS.
         check-config.mjs now pins this key to true, so the flip fails the lab check on purpose: it
         belongs to Task 8 Part B with a recorded owner decision, not to a sed edit. -->
    <entry key='mail.debug'>true</entry>

    <!-- Measured (evidence 005 §6b, spec §9.12): delivery calls the geocoder synchronously and it
         answers with an address resolved from the coordinates — even a synthetic lab one — turning a
         ~3 s delivery into ~114 s. It lives in the TEMPLATE, not only in the generated file, because
         `npm run lab:render` overwrites kidguard-lab.xml and would drop the fix silently. Production
         re-decides this; check-config rejects true so no lab run can reintroduce the leak. -->
    <entry key='geocoder.enable'>false</entry>

    <entry key='logger.console'>true</entry>
    <entry key='logger.fullStackTraces'>true</entry>

</properties>
